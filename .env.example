# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Public URL of the Node backend when serving the frontend from a static host (e.g. GitHub Pages).
# VITE_AI_API_URL="https://your-node-backend.example.com"

# Optional: Comma-separated origins allowed for /api/* CORS requests (defaults include *.github.io).
# ALLOWED_ORIGINS="https://username.github.io"

# AI Access Control & Rate Limiting
# Admin email allowed unconditionally and notified on access requests:
ADMIN_EMAIL="christianstelluti7@gmail.com"
# Comma-separated list of pre-approved user emails (persisted across stateless redeploys):
ALLOWED_USER_EMAILS=""
# Max AI requests per authenticated user per minute (default: 15):
AI_RATE_LIMIT_PER_MIN="15"
# Secret used to sign one-click approval links sent by email:
APPROVAL_TOKEN_SECRET=""

# Optional SMTP settings (e.g. Gmail with App Password) to send automatic approval request emails:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="ITS Study Assistant <your-email@gmail.com>"


